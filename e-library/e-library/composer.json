{
    "name": "stk-yakobus/e-library",
    "description": "E-Library Management System for STK Yakobus Merauke",
    "type": "project",
    "require": {
        "php": ">=7.4",
        "ext-mysqli": "*",
        "ext-gd": "*",
        "ext-zip": "*",
        "ext-mbstring": "*",
        "phpoffice/phpspreadsheet": "^1.29",
        "endroid/qr-code": "^4.8",
        "setasign/fpdf": "^1.8"
    },
    "require-dev": {},
    "autoload": {
        "psr-4": {
            "App\\": "libraries/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php -r \"echo 'E-Library dependencies installed successfully!\\n';\""
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
